{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trajectum.dev/schemas/engineering-record.schema.json",
  "title": "TRAJECTUM engineering data record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "category",
    "status",
    "revision",
    "source",
    "assumptions",
    "validity"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "record_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "category": {
      "enum": ["motor", "material", "atmosphere", "vehicle", "flight", "experiment"]
    },
    "status": {"enum": ["measured", "manufacturer", "derived", "provisional", "pending"]},
    "revision": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "validity": {"type": "string", "minLength": 1},
    "payload": {"type": "object"}
  }
}
