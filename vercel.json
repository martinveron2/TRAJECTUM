{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend/web && npm install && npm run build",
  "functions": {
    "main.py": {
      "maxDuration": 60,
      "includeFiles": "frontend/web/dist/**",
      "excludeFiles": "{**/tests/**,**/__pycache__/**,.venv/**}"
    }
  }
}
